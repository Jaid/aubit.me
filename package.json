{
  "name": "aubit.me",
  "displayName": "Aubit Viewer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A private, local-first workbench for Aubit code-audit reports",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/aubit.me.git"
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun run vite build",
    "build:development": "bun run vite build --mode development",
    "check": "bun run lint && bun run test && bun run test-live",
    "dev": "bun run vite --host 127.0.0.1",
    "lint": "bun run typecheck && bun run lint:style",
    "lint:style": "bunx --bun eslint . --max-warnings 0",
    "preview": "bun run vite preview --host 127.0.0.1",
    "test": "bun test",
    "test:browser": "bun scripts/browserChecks.mjs",
    "test-live": "bun run build && bun run test:browser",
    "typecheck": "bun ./node_modules/typescript-native/bin/tsc --noEmit --noUnusedLocals --pretty false",
    "vite": "bun --bun node_modules/vite/dist/node/cli --configLoader native"
  },
  "overrides": {
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "dependencies": {
    "antimono": "0.1.0",
    "aubit-schema": "0.3.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "dompurify": "3.5.0",
    "marked": "18.2.1",
    "monacozen": "0.6.0",
    "mount-root": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "stringify-clank": "0.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "autoprefixer": "10.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.29.6",
    "caniuse-lite": "1.0.30001827",
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "postcss": "8.5.33",
    "postcss-normalize": "13.0.1",
    "puppeteer-core": "25.18.1",
    "sass-embedded": "1.108.2",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "@babel/core": "8.1.3",
    "@rolldown/plugin-babel": "0.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "@types/bun": "1.4.5",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
